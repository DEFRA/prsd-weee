<details class="govuk-details">
    <summary class="govuk-details__summary">
        <span class="govuk-details__summary-text">
            What are the different types of protocol?
        </span>
    </summary>
    <div class="govuk-details__text">
        <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    Actual
                </dt>
                <dd class="govuk-summary-list__value">
                    (Tonnages are determined by weighing each category)
                </dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    Batteries in vapes
                </dt>
                <dd class="govuk-summary-list__value">
                    (Deduct the weight of batteries in vapes and electronic cigarettes)
                </dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    LDA protocol
                </dt>
                <dd class="govuk-summary-list__value">
                    (Large domestic appliance protocol)
                </dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    Light iron protocol
                </dt>
                <dd class="govuk-summary-list__value">
                    (WEEE in light iron protocol)
                </dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    Reuse Network PWP
                </dt>
                <dd class="govuk-summary-list__value">
                    (Reuse Network Product Weight Protocol)
                </dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    Site specific protocol
                </dt>
                <dd class="govuk-summary-list__value">
                    (also referred to as 'SSP')
                </dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    SMW protocol
                </dt>
                <dd class="govuk-summary-list__value">
                    (Small mixed WEEE protocol)
                </dd>
            </div>
        </dl>
    </div>
</details>
