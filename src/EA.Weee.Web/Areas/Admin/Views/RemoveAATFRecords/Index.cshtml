@using EA.Prsd.Core.Web.Mvc.RazorHelpers
@using EA.Weee.Core.Admin
@using EA.Weee.Requests.Admin
@using EA.Weee.Web.Areas.Admin.Controllers
@using EA.Weee.Web.Infrastructure.Paging
@using EA.Weee.Web.RazorHelpers
@using MvcNavigationHelpers
@using Resource = EA.Weee.Web.Areas.Admin.Views.RemoveAATFRecords.Index
@model EA.Weee.Web.Areas.Admin.ViewModels.RemoveAATFRecords.RemoveAatfsViewModel
@{
    ViewBag.Title = Resource.Title;
}

<div class="govuk-grid-row" style="margin-top: 30px;">
    <div class="govuk-grid-column-one-half">
        @(this.WeeeGds().BackLink(@Url.UrlFor<RemoveRecordsController>(a => a.ChooseActivity())))
    </div>
</div>

<header class="hgroup">
    <h1 class="govuk-heading-l" style="margin-top: 0px;">
        @Resource.Header
    </h1>
</header>

<p class="govuk-body">
    @Resource.BodyTextDesc1
</p>
<p class="govuk-body">
    @Resource.BodyTextDesc2
</p>

<p class="govuk-body">
    @Resource.BodyTextDesc3
</p>

@using (Html.BeginForm(actionName: "Index", controllerName: "RemoveAATFRecords", method: FormMethod.Post))
{
    <div class="filter" style=" border: 0px solid #fff !important">
        @Html.AntiForgeryToken()

        <div class="govuk-label">Filter by:</div>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group">
                    <Label class="govuk-label form-label" for="Filter_Name">Name of AATF</Label>
                    @Html.TextBoxFor(m => m.Name, new { @class = "govuk-!-width-three-quarters form-control govuk-input" })
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group">
                    @Html.Gds().LabelFor(m => m.ApprovalNumber, false)
                    @Html.TextBoxFor(m => m.ApprovalNumber, new { @class = "govuk-!-width-three-quarters form-control govuk-input" })
                </div>
            </div>

        </div>
        <div class="govuk-grid-row" style="margin-top: 20px;">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group @Html.Gds().FormGroupClass(m => m.SelectedComplianceYear)">
                    @Html.Gds().LabelFor(m => m.SelectedComplianceYear, false)
                    @Html.Gds().DropDownListFor(m => m.SelectedComplianceYear, new SelectList(Model.ComplianceYearList), string.Empty, new { autocomplete = "false", @class = "govuk-!-width-three-quarters" }, false, false)
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group @Html.Gds().FormGroupClass(m => m.SelectedAatfStatus)">
                    @Html.Gds().LabelFor(m => m.SelectedAatfStatus, false)
                    @Html.Gds().DropDownListFor(m => m.SelectedAatfStatus,
                                                Model.AatfStatuses.Select(x => new SelectListItem() { Text = x.DisplayName, Value = x.Value.ToString() }),
                                                string.Empty,
                                                new { autocomplete = "false", @class = "govuk-!-width-three-quarters" },
                                                false,
                                                false)

                </div>
            </div>
        </div>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group govuk-button-group" style="margin-top: 30px">

                    @this.WeeeGds().Button("Filter", new { name = "ActionFilter", id = "filter-apply-button" }, secondaryButton: false, filterButton: true)

                    @Html.ActionLink("Clear filter", "Index", new { @class = "link-submit govuk-link govuk-link--no-visited-state" })
                </div>
            </div>
        </div>
    </div>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <table class="govuk-table">
            <caption class="govuk-table__caption govuk-table__caption--l govuk-visually-hidden">Name of AATF</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Name of AATF</th>
                    <th scope="col" class="govuk-table__header">Approval number</th>
                    <th scope="col" class="govuk-table__header">Compliance year</th>
                    <th scope="col" class="govuk-table__header">Status</th>
                    <th scope="col" class="govuk-table__header"></th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @if (Model.AatfDataLists == null || Model.AatfDataLists.Count() == 0)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell govuk-table__caption--s" colspan="5">No records are available.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.AatfDataLists)
                    {
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">@item.Name</td>
                            <td class="govuk-table__cell">@item.ApprovalNumber</td>
                            <td class="govuk-table__cell">@item.ComplianceYear</td>
                            <td class="govuk-table__cell">@item.AatfStatus</td>
                            <td class="govuk-table__cell">
                                <a href="@Url.Action("ConfirmDeletion", new
                                {
                                    aatfId = item.Id,
                                    name = item.Name,
                                    approvalNumber = item.ApprovalNumber,
                                    complianceYear = item.ComplianceYear,
                                    status = item.AatfStatus
                                })">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        @if (Model.AatfDataLists != null && Model.AatfDataLists.PageCount > 1)
        {
            <div id="pager">
                <div class="pager govuk-body">
                    @Html.Pager(Model.AatfDataLists.PageSize,
                                Model.AatfDataLists.PageNumber,
                                Model.AatfDataLists.TotalItemCount).Options(o => o.Action("Index").RouteValues(new
                                {
                                    name = Model.Name,
                                    approvalNumber = Model.ApprovalNumber,
                                    selectedComplianceYear = Model.SelectedComplianceYear,
                                    selectedAatfStatus = Model.SelectedAatfStatus
                                }))
                </div>

                <p class="govuk-body">Showing @Model.AatfDataLists.ItemStart - @Model.AatfDataLists.ItemEnd of @Model.AatfDataLists.TotalItemCount</p>
            </div>
        }
    </div>
</div>
