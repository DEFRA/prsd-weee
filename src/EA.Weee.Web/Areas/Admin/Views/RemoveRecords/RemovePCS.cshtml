@using EA.Prsd.Core.Web.Mvc.RazorHelpers
@using EA.Weee.Core.Admin
@using EA.Weee.Requests.Admin
@using EA.Weee.Web.Areas.Admin.Controllers
@using EA.Weee.Web.Infrastructure.Paging
@using EA.Weee.Web.RazorHelpers
@using MvcNavigationHelpers
@model EA.Weee.Web.Areas.Admin.ViewModels.RemoveRecords.RemovePCSRecordsFilterViewModel
@{
    ViewBag.Title = "Remove Records";
}

<header class="hgroup">
    <h1 class="govuk-heading-l">
        Remove PCS records
    </h1>
</header>

<p class="govuk-body">
    The PCS records displayed have exceeded the 7-year retention period and are now available for deletion from WEEE Online.
</p>
<p class="govuk-body">
    The PCS information to be deleted from both the internal and external services include:
</p>
<ul class="govuk-list govuk-list--bullet">
    <li>Member registration details</li>
    <li>Member EEE data</li>
    <li>WEEE data</li>
    <li>Obligations data</li>
    <li>Member registration charges records</li>
</ul>
<p class="govuk-body">
    Upon clicking 'Delete' you will be asked if you wish to confirm the deletion
</p>
<div class="govuk-warning-text">
    <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
    <strong class="govuk-warning-text__text">
        <span class="govuk-visually-hidden">Warning</span>
        deleting a record is a permanent action. It cannot be undone.
    </strong>
</div>

@using (Html.BeginForm(actionName: "RemovePCS", controllerName: "RemoveRecords", method: FormMethod.Post))
{
    <div class="filter">
        @Html.AntiForgeryToken()
        @Html.Hidden(Model.SelectedYear)
        @Html.Hidden(Model.SelectedScheme)

        <div class="govuk-label">Filter by:</div>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group @Html.Gds().FormGroupClass(m => m.SelectedYear)">
                    @Html.Gds().LabelFor(m => m.SelectedYear)
                    @Html.Gds().DropDownListFor(m => m.SelectedYear, Model.ComplianceYears, new { @class = "govuk-!-width-one-half", autocomplete = "false" })
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group @Html.Gds().FormGroupClass(m => m.SelectedScheme)">
                    @Html.Gds().LabelFor(m => m.SelectedScheme)
                    @Html.Gds().DropDownListFor(m => m.SelectedScheme, Model.SchemeNames, new { @class = "govuk-!-width-one-half", autocomplete = "false" })
                </div>
            </div>
        </div>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half govuk-form-group govuk-button-group">
                @(this.WeeeGds().Submit("Filter"))
                @Html.ActionLink("Clear filter", "RemovePCS", new { @class = "link-submit govuk-link" })
            </div>
        </div>
    </div>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <table class="govuk-table">
            <caption class="govuk-table__caption govuk-table__caption--l govuk-visually-hidden">This table shows the PCS records for the selected year and scheme.</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">PCS name</th>
                    <th scope="col" class="govuk-table__header">Approval number</th>
                    <th scope="col" class="govuk-table__header">Compliance Year</th>
                    <th scope="col" class="govuk-table__header"></th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var item in Model.Results.SchemeData)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@item.SchemeName</td>
                        <td class="govuk-table__cell">@item.ApprovalNumber</td>
                        <td class="govuk-table__cell">@item.ComplianceYear</td>
                        <td class="govuk-table__cell"><a href="@Url.Action("ConfirmDeletion", new { id = item.SchemeId, complianceYear = item.ComplianceYear })">Delete</a></td>
                    </tr>
                }
            </tbody>
        </table>

        @if (@Model.Results.SchemeData.PageCount > 1)
        {
            <div id="pager">
                <div class="pager govuk-body">
                    @Html.Pager(Model.Results.SchemeData.PageSize, Model.Results.SchemeData.PageNumber, Model.Results.SchemeData.TotalItemCount).Options(o => o.Action("RemovePCS").RouteValues(new { sortOrder = Model.Results.SortOrder, selScheme = Model.SelectedScheme, selYear = Model.SelectedYear }))
                </div>

                <p class="govuk-body">Showing @Model.Results.SchemeData.ItemStart - @Model.Results.SchemeData.ItemEnd of @Model.Results.SchemeData.TotalItemCount</p>
            </div>
        }

        <p>
            <a href="@(Url.UrlFor<RemoveRecordsController>(a => a.ChooseActivity()))">Back</a>
        </p>
    </div>
</div>
