@using EA.Prsd.Core.Web.Mvc.RazorHelpers
@using EA.Weee.Core.Admin
@using EA.Weee.Requests.Admin
@using EA.Weee.Web.Areas.Admin.Controllers
@using EA.Weee.Web.Infrastructure.Paging
@using EA.Weee.Web.RazorHelpers
@using MvcNavigationHelpers
@model EA.Weee.Web.Areas.Admin.ViewModels.RemoveRecords.RemovePCSRecordsConfirmDeletionViewModel
@{
    ViewBag.Title = "Deleted";
}

<div class="govuk-panel govuk-panel--confirmation">
    <div class="govuk-panel__body">
        The following PCS record has been deleted from the WEEE Online service
    </div>
</div>

<table class="govuk-table prsd-table">
    <caption class="govuk-visually-hidden">This table shows the deleted PCS record.</caption>
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th class="govuk-table__header" scope="col">PCS name</th>
            <th class="govuk-table__header" scope="col">Approval number</th>
            <th class="govuk-table__header" scope="col">Compliance year</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        <tr class="govuk-table__row">
            <td class="govuk-table__cell">@Model.PCSName</td>
            <td class="govuk-table__cell" style="text-align:left">@Model.ApprovalNumber</td>
            <td class="govuk-table__cell">@Model.ComplianceYear</td>
        </tr>
    </tbody>
</table>

<p>
    @Html.ActionLink("Back", "RemovePCS", null, null)
</p>
}

