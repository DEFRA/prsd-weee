@using System.Web.Mvc.Html
@using EA.Weee.Web.Controllers
@using EA.Weee.Web.RazorHelpers
@using MvcNavigationHelpers
@using ProducerSubmission.Registered
@model EA.Weee.Web.Areas.Producer.ViewModels.RegisteredResultModel
@{
    var title = Registered.Title;
    ViewBag.Title = @title + " - GOV.UK";
}

@section full_main_content{
    <div class="govuk-!-padding-bottom-5"></div>
    <div class="govuk-panel govuk-panel--confirmation govuk-!-width-two-thirds">
        <h1 class="govuk-panel__title">
            @if (Model.HasPaid == true)
            {
                @Html.Raw(string.Format(Registered.HasPaidTitle, @Model.ComplianceYear))
            }
            else
            {
                @Html.Raw(string.Format(Registered.RegisteredTitle, @Model.ComplianceYear))
            }
        </h1>
    </div>
    <div class="govuk-!-width-two-thirds">
        @if (Model.HasPaid == true)
        {
            <p class="govuk-body">
                @Registered.HasPaidDesc
            </p>
        }
        else
        {
            <p class="govuk-body">
                @Registered.RegisteredDesc
            </p>
        }

        @Html.Partial("_ContactPartial")
    </div>

    @Html.ActionLink("Perform other activities", "ChooseActivity", "Home", new { area = "Scheme", pcsId = Model.OrganisationId }, new { @class = "govuk-button" })
}