@using EA.Weee.Web.Controllers
@using EA.Weee.Web.RazorHelpers
@using MvcNavigationHelpers

<div class="govuk-phase-banner">
    <p class="govuk-phase-banner__content"><strong class="govuk-tag govuk-phase-banner__content__tag govuk-phase-tag-override">
            BETA
        </strong>
        <span class="govuk-phase-banner__text">
            You can help us improve this service by giving your
            @(this.WeeeGds().ActionLinkWithEventTracking("feedback",
                  "Provide feedback on the WEEE online service",
                  Url.UrlFor<NewUserController>(c => c.Feedback()),
                  "Feedback",
                  "Banner",
                  "Feedback link",
                  null,
                  true
                  ))
        </span>
    </p>
</div>
