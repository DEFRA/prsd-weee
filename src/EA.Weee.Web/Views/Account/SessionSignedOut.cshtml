<header class="hgroup">
    <h1 class="govuk-heading-l">
        You have been signed out
    </h1>
</header>

<div class="govuk-body">
    <p>You have been signed out and any information you have not saved has been deleted. This is to protect your account information.</p>
</div>

<form id="signoutForm" method="get" action="/Account/SignIn">
    @Html.AntiForgeryToken()
    <input class="govuk-button_automation-ignored" id="link-sign-in" type="submit" value="Sign back in" />
</form>